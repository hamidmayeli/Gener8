<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.DynamoDBv2" />
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gener8\Gener8.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Abstractions: [FromModel], RepositoryType, IRepository, etc. -->
    <ProjectReference Include="..\..\src\Gener8.Abstractions\Gener8.Abstractions.csproj" />
    <!-- Extension packages for SDK-specific converters and base classes -->
    <ProjectReference Include="..\..\src\Gener8.Extensions.DynamoDB\Gener8.Extensions.DynamoDB.csproj" />
    <ProjectReference Include="..\..\src\Gener8.Extensions.MongoDB\Gener8.Extensions.MongoDB.csproj" />
  </ItemGroup>
</Project>
