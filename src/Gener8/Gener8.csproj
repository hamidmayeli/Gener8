<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet metadata -->
    <PackageId>Gener8</PackageId>
    <Version>0.0.1</Version>
    <Authors>Hamid Mayeli</Authors>
    <Description>C# source generator that copies public properties from a model class to a decorated partial DTO class.</Description>
    <PackageTags>source-generator;roslyn;dto;code-generation;c#</PackageTags>
    <PackageProjectUrl>https://github.com/hamidmayeli/from-model</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hamidmayeli/from-model</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Source generators must live under analyzers/dotnet/cs/, not lib/ -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- NU5128: no lib/ assemblies is intentional for source generators -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- Consumers don't need a runtime reference; mark as dev-only -->
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <!-- Place the generator DLL in the correct analyzer slot inside the .nupkg -->
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
