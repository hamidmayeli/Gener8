<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>

    <!-- NuGet metadata -->
    <PackageId>Gener8.Extensions.DynamoDB</PackageId>
    <Version>0.0.1</Version>
    <Authors>Hamid Mayeli</Authors>
    <Description>DynamoDB extension for Gener8: compiled converters and abstract repository base class. Requires AWSSDK.DynamoDBv2.</Description>
    <PackageTags>source-generator;roslyn;dto;dynamodb;aws;code-generation;c#</PackageTags>
    <PackageProjectUrl>https://github.com/hamidmayeli/from-model</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hamidmayeli/from-model</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>gener8.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../gener8.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.DynamoDBv2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gener8.Abstractions\Gener8.Abstractions.csproj" />
  </ItemGroup>

</Project>
